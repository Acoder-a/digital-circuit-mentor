DASHSCOPE_API_KEY=添加你的API_KEY
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_ID=qwen-max
PORT=3010
FRONTEND_PORT=3001

# PostgreSQL 16 + pgvector（可用根目录 docker-compose.yml 一键启动）
DATABASE_URL=postgresql://mentor:mentor_dev_password@127.0.0.1:5432/digital_circuit_mentor
DATABASE_SSL=false

# RAG / Embedding
RAG_ENABLED=true
EMBEDDING_MODEL_ID=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
RAG_INITIAL_K=8
RAG_FINAL_K=4
RAG_MIN_SCORE=0.18
KNOWLEDGE_CHUNK_MIN=400
KNOWLEDGE_CHUNK_MAX=700
KNOWLEDGE_CHUNK_OVERLAP=100
KNOWLEDGE_OCR_ENABLED=true
KNOWLEDGE_OCR_LANGUAGE=chi_sim+eng

# 三级记忆
MEMORY_RECENT_PAIRS=8
MEMORY_SUMMARY_THRESHOLD=20
MEMORY_RECALL_K=4
AUTH_SESSION_DAYS=30

# 手机验证码（阿里云短信服务；签名/模板需先通过审核）
SMS_CODE_SECRET=请设置至少24位的随机字符串
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# 仅本地开发可开启；返回验证码用于调试，生产环境会强制禁用
SMS_DEV_MODE=false
